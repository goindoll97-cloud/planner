# 국가법령정보 공동활용 OPEN API 인증값
# 실제 인증값은 .env 파일에만 넣고 GitHub에 커밋하지 마세요.
LAW_OC=

# 한국산업안전보건공단_물질안전보건자료 조회 서비스
# 공공데이터포털(data.go.kr) 데이터셋 15157612에서 발급받은 인증키를 사용합니다.
# 실제 인증값은 .env 파일에만 넣고 GitHub에 커밋하지 마세요.
KOSHA_MSDS_SERVICE_KEY=

# 현재 공공데이터포털 운영 기본 URL. 서비스 버전이 바뀌거나
# 활용가이드에서 별도 운영 URL을 안내할 때만 변경하세요.
KOSHA_MSDS_BASE_URL=https://apis.data.go.kr/B552468/msdschem
# KOSHA_MSDS_SEARCH_URL=https://apis.data.go.kr/B552468/msdschem/getChemList
# 필요 시 개별 상세항목 URL도 override 가능:
# KOSHA_MSDS_SECTION_01_URL=https://apis.data.go.kr/B552468/msdschem/getChemDetail01
# ...
# KOSHA_MSDS_SECTION_16_URL=https://apis.data.go.kr/B552468/msdschem/getChemDetail16
