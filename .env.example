# 국가법령정보 공동활용 OPEN API 인증값
# 실제 인증값은 .env 파일에만 넣고 GitHub에 커밋하지 마세요.
LAW_OC=

# 한국산업안전보건공단 물질안전보건자료 조회 서비스
# 공공데이터포털(data.go.kr)에서 발급받은 일반 인증키를 사용합니다.
# 실제 인증값은 .env 파일에만 넣고 GitHub에 커밋하지 마세요.
KOSHA_SERVICE_KEY=

# 필요할 때만 변경하세요. 기본값은 아래 공공데이터포털 REST API입니다.
KOSHA_API_URL=https://apis.data.go.kr/B552468/msdschem
