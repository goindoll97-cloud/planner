# 국가법령정보 공동활용 OPEN API 인증값
# 실제 인증값은 .env 파일에만 넣고 GitHub에 커밋하지 마세요.
LAW_OC=

# 한국산업안전보건공단_물질안전보건자료 조회 서비스
# 공공데이터포털(data.go.kr)에서 발급받은 인증키를 사용합니다.
# 실제 인증값은 .env 파일에만 넣고 GitHub에 커밋하지 마세요.
KOSHA_MSDS_SERVICE_KEY=

# 보통 아래 기본값을 그대로 사용합니다. 공공데이터포털 활용가이드의
# 운영 URL이 계정/서비스 버전에서 다를 때만 변경하세요.
KOSHA_MSDS_BASE_URL=https://msds.kosha.or.kr/openapi/service/msdschem
# KOSHA_MSDS_SEARCH_URL=https://msds.kosha.or.kr/openapi/service/msdschem/chemlist
# KOSHA_MSDS_SECTION2_URL=https://msds.kosha.or.kr/openapi/service/msdschem/chemdetail02
